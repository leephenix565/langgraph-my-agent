# TAVILY_API_KEY=
LANGSMITH_TRACING=true
TAVILY_API_KEY=
LANGSMITH_API_KEY=
# To separate your traces from other application
LANGSMITH_PROJECT=react-agent
DISABLE_SEARCH=0
LANGSMITH_TRACING=false


# Main multi-agent global provider. DS-1 does not migrate this path.
# Cerebras (OpenAI-compatible base URL)
MODEL=openai/qwen-3-235b-a22b-instruct-2507
OPENAI_BASE_URL=https://api.cerebras.ai/v1
OPENAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# Commercial API line: Fair Fusion baseline sidecar on DeepSeek V4.
# This does not change MODEL / OPENAI_BASE_URL / OPENAI_API_KEY.
# The sidecar is not called unless ENABLE_FAIR_FUSION=1, and final-answer
# source switching stays off unless ENABLE_FAIR_FUSION_SOURCE_SWITCH=1.
BASELINE_MODEL=openai/deepseek-v4-pro
BASELINE_OPENAI_BASE_URL=https://api.deepseek.com
BASELINE_OPENAI_API_KEY=
ENABLE_FAIR_FUSION=0
ENABLE_FAIR_FUSION_SOURCE_SWITCH=0


## LLM choice:
ANTHROPIC_API_KEY=....
FIREWORKS_API_KEY=...

DEEPSEEK_API_KEY=




