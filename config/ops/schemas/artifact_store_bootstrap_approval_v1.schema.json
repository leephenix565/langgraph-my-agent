{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/artifact_store_bootstrap_approval_v1.schema.json",
  "title": "agent_sync_artifact_store_bootstrap_approval_v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "approval_id",
    "status",
    "plan_id",
    "plan_sha256",
    "environment_binding_sha256",
    "environment_snapshot_sha256",
    "approved_at",
    "expires_at",
    "execution_phase",
    "bootstrap_approved",
    "approved_action_ids",
    "operator_reference"
  ],
  "properties": {
    "schema_version": {
      "const": "agent_sync_artifact_store_bootstrap_approval_v1"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "approved",
        "rejected",
        "draft"
      ]
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_sha256": {
      "type": "string",
      "minLength": 64
    },
    "environment_snapshot_sha256": {
      "type": "string",
      "minLength": 64
    },
    "environment_binding_sha256": {
      "type": "string",
      "minLength": 64
    },
    "approved_at": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    },
    "execution_phase": {
      "const": "SYNC-OPS-2B0"
    },
    "bootstrap_approved": {
      "type": "boolean"
    },
    "rollback_approved": {
      "type": "boolean"
    },
    "approved_action_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operator_reference": {
      "type": "string",
      "minLength": 1
    }
  }
}
