{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlut.example/agent-sync/cutover_physical_tree_descriptor_v2.schema.json",
  "title": "SYNC-OPS Cutover Physical Tree Descriptor V2",
  "type": "object",
  "required": [
    "schema_version",
    "algorithm",
    "scope",
    "entry_contract_version",
    "root_relative_entry",
    "physical_tree_digest",
    "classification_manifest_sha256",
    "entry_count",
    "regular_file_count",
    "directory_count_including_root",
    "symlink_count",
    "special_file_count",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "agent_sync_cutover_physical_tree_descriptor_v2"},
    "algorithm": {"const": "sha256"},
    "scope": {"const": "source_loss_cutover_physical_tree"},
    "entry_contract_version": {"const": "cutover_physical_entry_v2"},
    "root_relative_entry": {"const": "."},
    "physical_tree_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classification_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry_count": {"type": "integer", "minimum": 0},
    "regular_file_count": {"type": "integer", "minimum": 0},
    "directory_count_including_root": {"type": "integer", "minimum": 1},
    "symlink_count": {"type": "integer", "minimum": 0},
    "special_file_count": {"type": "integer", "minimum": 0},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
