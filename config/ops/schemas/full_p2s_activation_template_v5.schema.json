{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlut.example/agent-sync/full_p2s_activation_template_v5.schema.json",
  "title": "SYNC-OPS Full P2S Activation Template V5",
  "type": "object",
  "required": ["schema_version", "request_id", "status", "plan_id", "plan_sha256", "stage", "activate", "rollback", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "agent_sync_full_p2s_activation_template_v5"},
    "status": {"const": "blocked_pending_real_stage_closeout"},
    "stage": {"const": false},
    "activate": {"const": true},
    "rollback": {"const": true},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
