{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlut.example/agent-sync/full_p2s_rebase_plan_v6.schema.json",
  "title": "SYNC-OPS Full P2S Rebase Plan V6",
  "type": "object",
  "required": ["schema_version", "plan_id", "stage_request_status", "activation_template_status", "recovery_plan_gate", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "agent_sync_full_p2s_rebase_plan_v6"},
    "plan_id": {"type": "string", "minLength": 1},
    "stage_request_status": {"const": "blocked_pending_recovery_settle"},
    "activation_template_status": {"const": "blocked_pending_real_stage_closeout"},
    "recovery_plan_gate": {"type": "object"},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
