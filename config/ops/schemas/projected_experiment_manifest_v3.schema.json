{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_sync_projected_experiment_manifest_v3",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "workspace_root",
    "change_unit",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": { "const": "agent_sync_projected_experiment_manifest_v3" },
    "experiment_id": { "type": "string", "minLength": 1 },
    "workspace_root": { "type": "string", "minLength": 1 },
    "change_unit": { "type": "object" },
    "canonical_sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
  },
  "additionalProperties": true
}
