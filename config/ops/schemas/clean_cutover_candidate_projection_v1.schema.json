{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlut.example/agent-sync/clean_cutover_candidate_projection_v1.schema.json",
  "title": "SYNC-OPS Clean Cutover Candidate Projection V1",
  "type": "object",
  "required": [
    "schema_version",
    "root",
    "source_action_count",
    "regular_file_count",
    "parent_directory_count",
    "root_entry_count",
    "directory_count_including_root",
    "projected_entry_count",
    "runtime_artifact_count",
    "unknown_entry_count",
    "unexpected_entries",
    "source_descriptor",
    "full_entry_digest",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "agent_sync_clean_cutover_candidate_projection_v1"},
    "root": {"type": "string", "minLength": 1},
    "source_action_count": {"const": 67},
    "regular_file_count": {"const": 67},
    "parent_directory_count": {"const": 10},
    "root_entry_count": {"const": 1},
    "directory_count_including_root": {"const": 11},
    "root_included": {"const": true},
    "projected_entry_count": {"const": 78},
    "entry_count": {"const": 78},
    "symlink_count": {"const": 0},
    "special_file_count": {"const": 0},
    "runtime_artifact_count": {"const": 0},
    "data_model_reference_count": {"const": 0},
    "unknown_entry_count": {"const": 0},
    "sensitive_entry_count": {"const": 0},
    "unexpected_entries": {"type": "array", "maxItems": 0},
    "source_descriptor": {"type": "object"},
    "full_entry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
