{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlut.example/agent-sync/directory_mode_authority_v1.schema.json",
  "title": "SYNC-OPS Directory Mode Authority V1",
  "type": "object",
  "required": [
    "schema_version",
    "canonical_root",
    "canonical_root_mode",
    "source_root",
    "directory_count_including_root",
    "directories",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "agent_sync_directory_mode_authority_v1"},
    "canonical_root": {"type": "string", "minLength": 1},
    "canonical_root_mode": {"type": "string", "pattern": "^0o[0-7]{3,4}$"},
    "source_root": {"type": "string", "minLength": 1},
    "directory_count_including_root": {"type": "integer", "minimum": 1},
    "directories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relative_path", "candidate_pre_cutover_mode", "canonical_post_cutover_mode", "mode_transition_required"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "candidate_pre_cutover_mode": {"type": "string", "pattern": "^0o[0-7]{3,4}$"},
          "canonical_post_cutover_mode": {"type": "string", "pattern": "^0o[0-7]{3,4}$"},
          "mode_transition_required": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
