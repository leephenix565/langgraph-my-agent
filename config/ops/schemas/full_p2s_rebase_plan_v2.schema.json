{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_sync_full_p2s_rebase_plan_v2",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "recovery_plan_gate",
    "baseline_id",
    "stage_root",
    "activation_candidate_path",
    "activation_archive_path",
    "agent_dispositions",
    "materialization_manifest",
    "expected_full_stage_descriptor",
    "stage_approval_request",
    "activation_request_template",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "agent_sync_full_p2s_rebase_plan_v2"
    },
    "agent_dispositions": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26
    },
    "materialization_manifest": {
      "type": "array",
      "minItems": 1
    },
    "risk_fraud_expected_file_count": {
      "const": 67
    },
    "stage_approval_request": {
      "type": "object",
      "required": ["stage_requested", "verify_requested", "activate_requested", "rollback_requested", "requested_action_ids"],
      "properties": {
        "stage_requested": { "const": true },
        "verify_requested": { "const": true },
        "activate_requested": { "const": false },
        "rollback_requested": { "const": false }
      },
      "additionalProperties": true
    },
    "activation_request_template": {
      "type": "object",
      "required": ["status", "activate_requested", "rollback_requested"],
      "properties": {
        "status": { "const": "blocked_pending_real_stage_closeout" },
        "activate_requested": { "const": true },
        "rollback_requested": { "const": true }
      },
      "additionalProperties": true
    },
    "canonical_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    }
  },
  "additionalProperties": true
}
