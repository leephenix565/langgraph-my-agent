{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlut.example/agent-sync/full_p2s_rebase_plan_v4.schema.json",
  "title": "SYNC-OPS Full P2S Rebase Plan V4",
  "type": "object",
  "required": ["schema_version", "plan_id", "stage_request_status", "activation_template_status", "approval_boundary", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "agent_sync_full_p2s_rebase_plan_v4"},
    "plan_id": {"type": "string", "minLength": 1},
    "stage_request_status": {"const": "blocked_pending_recovery_settle"},
    "activation_template_status": {"const": "blocked_pending_real_stage_closeout"},
    "approval_boundary": {
      "type": "object",
      "required": ["single_broad_preapproval_forbidden"],
      "properties": {
        "single_broad_preapproval_forbidden": {"const": true}
      },
      "additionalProperties": true
    },
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
