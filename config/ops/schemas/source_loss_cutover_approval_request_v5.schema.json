{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlut.example/agent-sync/source_loss_cutover_approval_request_v5.schema.json",
  "title": "SYNC-OPS Source Loss Cutover Approval Request V5",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "status",
    "plan_id",
    "plan_sha256",
    "canonical_target_path",
    "fresh_cutover_candidate_path",
    "archive_path",
    "production_launch_authority_sha256",
    "requested_action_ids",
    "endpoint_scopes",
    "permissions",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "agent_sync_source_loss_cutover_approval_request_v5"},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"const": "awaiting_machine_approval"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_action_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "endpoint_scopes": {
      "type": "object",
      "properties": {
        "invoke": {"const": false},
        "provider": {"const": false}
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "properties": {
        "sigkill": {"const": false},
        "delete": {"const": false},
        "p2s": {"const": false},
        "first_cycle": {"const": false},
        "irreversible_source_loss_acknowledgement": {"const": true}
      },
      "additionalProperties": true
    },
    "approval_id": {"const": ""},
    "approved_at": {"const": ""},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
