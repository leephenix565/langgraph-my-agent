{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlut.example/agent-sync/incumbent_canary_equivalence_v1.schema.json",
  "title": "SYNC-OPS Incumbent Canary Equivalence V1",
  "type": "object",
  "required": [
    "schema_version",
    "service_unit_id",
    "request_fixture",
    "health_rules",
    "compute_rules",
    "adapter_rules",
    "canary_must_not_be_worse",
    "blocking_new_degradation_categories",
    "diagnostic_only_differences",
    "raw_body_persistence_forbidden",
    "fixture_sha256",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "agent_sync_incumbent_canary_equivalence_v1"},
    "service_unit_id": {"type": "string", "minLength": 1},
    "request_fixture": {"type": "object"},
    "health_rules": {"type": "array", "items": {"type": "string"}},
    "compute_rules": {"type": "array", "items": {"type": "string"}},
    "adapter_rules": {"type": "array", "items": {"type": "string"}},
    "severity_order": {"type": "array", "items": {"type": "string"}},
    "canary_must_not_be_worse": {"const": true},
    "blocking_new_degradation_categories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "diagnostic_only_differences": {"type": "array", "contains": {"const": "body_sha256"}, "items": {"type": "string"}},
    "raw_body_persistence_forbidden": {"const": true},
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
