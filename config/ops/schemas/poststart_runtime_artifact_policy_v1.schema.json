{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlut.example/agent-sync/poststart_runtime_artifact_policy_v1.schema.json",
  "title": "SYNC-OPS Post-Start Runtime Artifact Policy V1",
  "type": "object",
  "required": [
    "schema_version",
    "allowed_paths",
    "allowed_classes",
    "forbidden_paths",
    "source_descriptor_must_remain",
    "unknown_runtime_artifacts_allowed",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "agent_sync_poststart_runtime_artifact_policy_v1"},
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "allowed_classes": {"type": "array", "items": {"type": "string"}},
    "forbidden_paths": {"type": "array", "items": {"type": "string"}},
    "source_descriptor_must_remain": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unknown_runtime_artifacts_allowed": {"const": false},
    "raw_runtime_bytes_in_portable_artifact": {"const": false},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
