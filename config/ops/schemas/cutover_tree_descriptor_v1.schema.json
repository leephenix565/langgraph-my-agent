{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlut.example/agent-sync/cutover_tree_descriptor_v1.schema.json",
  "title": "SYNC-OPS Cutover Full Tree Descriptor V1",
  "type": "object",
  "required": [
    "schema_version",
    "root",
    "root_role",
    "source_bearing_descriptor",
    "full_entry_digest",
    "entry_count",
    "regular_file_count",
    "directory_count",
    "symlink_count",
    "special_file_count",
    "runtime_artifact_count",
    "data_model_reference_count",
    "unknown_entry_count",
    "sensitive_entry_count",
    "classification_counts",
    "unexpected_entries",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "agent_sync_cutover_tree_descriptor_v1"},
    "root": {"type": "string", "minLength": 1},
    "root_role": {"type": "string", "minLength": 1},
    "source_bearing_descriptor": {"type": "object"},
    "full_entry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry_count": {"type": "integer", "minimum": 0},
    "regular_file_count": {"type": "integer", "minimum": 0},
    "directory_count": {"type": "integer", "minimum": 0},
    "symlink_count": {"type": "integer", "minimum": 0},
    "special_file_count": {"type": "integer", "minimum": 0},
    "runtime_artifact_count": {"type": "integer", "minimum": 0},
    "data_model_reference_count": {"type": "integer", "minimum": 0},
    "unknown_entry_count": {"type": "integer", "minimum": 0},
    "sensitive_entry_count": {"type": "integer", "minimum": 0},
    "classification_counts": {"type": "object"},
    "unexpected_entries": {"type": "array", "items": {"type": "string"}},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
