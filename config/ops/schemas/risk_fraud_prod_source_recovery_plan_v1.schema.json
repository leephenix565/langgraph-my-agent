{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agent_sync_risk_fraud_prod_source_recovery_plan_v1.schema.json",
  "title": "agent_sync_risk_fraud_prod_source_recovery_plan_v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "tool_version",
    "plan_id",
    "created_at",
    "expires_at",
    "agent_id",
    "source_authority",
    "target_prod_root",
    "target_before_descriptor",
    "expected_target_after_descriptor",
    "file_actions",
    "backup_contract",
    "offline_test_contract",
    "process_contract",
    "live_validation_contract",
    "rollback_contract",
    "approval_requirements",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "agent_sync_risk_fraud_prod_source_recovery_plan_v1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "const": "risk_financial_fraud"
    },
    "source_authority": {
      "type": "object"
    },
    "target_prod_root": {
      "type": "string",
      "minLength": 1
    },
    "expected_target_after_descriptor": {
      "type": "object"
    },
    "file_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action_id", "operation", "relative_path", "source_sha256"],
        "properties": {
          "operation": {
            "enum": ["add", "replace"]
          }
        },
        "additionalProperties": true
      }
    },
    "canonical_sha256": {
      "type": "string",
      "minLength": 1
    }
  }
}
