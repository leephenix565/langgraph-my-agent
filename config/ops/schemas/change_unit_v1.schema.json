{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agent_sync_change_unit_v1.schema.json",
  "title": "agent_sync_change_unit_v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "change_unit_id",
    "agent_id",
    "change_family",
    "risk_class",
    "files",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "agent_sync_change_unit_v1"
    },
    "change_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "change_family": {
      "type": "string",
      "minLength": 1
    },
    "risk_class": {
      "enum": [
        "A_docs_tests_material",
        "B_protocol_wrapper",
        "C_data_dependency",
        "D_business_core",
        "S_security_deployment"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "base_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_review_required": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "draft",
        "open",
        "approved_for_plan",
        "closed",
        "aborted"
      ]
    }
  }
}
