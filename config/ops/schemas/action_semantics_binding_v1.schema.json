{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlut.example/agent-sync/action_semantics_binding_v1.schema.json",
  "title": "SYNC-OPS Action Semantics Binding V1",
  "type": "object",
  "required": [
    "schema_version",
    "rehearsal_action_count",
    "final_action_count",
    "bound_action_count",
    "binding_pairs",
    "action_semantics_set_sha256",
    "valid",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "agent_sync_action_semantics_binding_v1"},
    "rehearsal_action_count": {"type": "integer", "minimum": 0},
    "final_action_count": {"type": "integer", "minimum": 0},
    "bound_action_count": {"type": "integer", "minimum": 0},
    "binding_pairs": {"type": "array"},
    "action_semantics_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "valid": {"type": "boolean"},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
